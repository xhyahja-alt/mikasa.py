print("PROGRAM NILAI SISWA")

nama = input("Masukkan nama: ")
nilai = int(input("Masukkan nilai: "))

if nilai >= 75 and nilai <= 100:
    print("Nama:", nama)
    print("Nilai:", nilai)
    print("Keterangan: Lulus")
else:
    print("Nama:", nama)
    print("Nilai:", nilai)
    print("Keterangan: Tidak Lulus")